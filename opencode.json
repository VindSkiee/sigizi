{
  "$schema": "https://opencode.ai/config.json",

  "model": "opencode/mimo-v2.5-free",

  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },

  "snapshot": true,

  "autoupdate": true,

  "formatter": {
    "prettier": {
      "disabled": false
    }
  },

  "lsp": {
    "typescript": {
      "disabled": false,
      "command": ["npx", "-y", "typescript-language-server", "--stdio"]
    }
  },

  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".next/**",
      "coverage/**",
      ".git/**"
    ]
  },

  "mcp": {
    "git": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-git"],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": true,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
      }
    },
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/mnt/c/MYPROJECTS/HACKATHON/sigizi"
      ],
      "enabled": true
    },
    "postgres": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-postgres",
        "{env:DATABASE_URL}"
      ],
      "enabled": true,
      "environment": {
        "DATABASE_URL": "postgresql://postgres:postgres@localhost:5432/sigizi"
      }
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true
    }
  },

  "tools": {
    "git_*": false,
    "github_*": false,
    "postgres_*": false,
    "filesystem_*": false,
    "memory_*": false,
    "context7_*": false,
    "sequential-thinking_*": false
  },

  "agent": {
    "backend(plan)": {
      "description": "Backend planning agent - read-only mode for analyzing code and creating implementation plans",
      "mode": "subagent",
      "model": "opencode/mimo-v2.5-free",
      "prompt": "{file:.opencode/agents/backend-plan.md}",
      "permission": {
        "edit": "deny",
        "bash": {
          "git *": "allow",
          "git status": "allow",
          "git log*": "allow",
          "git diff": "allow",
          "git diff*": "allow",
          "ls *": "allow",
          "cat *": "allow",
          "find *": "allow",
          "grep *": "allow",
          "pwd": "allow",
          "*": "deny"
        }
      }
    },
    "backend(build)": {
      "description": "Backend build agent - implements code from plans or prompts for NestJS + Prisma",
      "mode": "primary",
      "model": "opencode/mimo-v2.5-free",
      "prompt": "{file:.opencode/agents/backend-build.md}",
      "permission": {
        "edit": "allow",
        "bash": {
          "git *": "allow",
          "git status": "allow",
          "git log*": "allow",
          "git diff": "allow",
          "git diff*": "allow",
          "git add *": "allow",
          "git commit *": "allow",
          "git push*": "allow",
          "pnpm *": "allow",
          "npm *": "allow",
          "npx *": "allow",
          "node *": "allow",
          "ls *": "allow",
          "cat *": "allow",
          "find *": "allow",
          "grep *": "allow",
          "pwd": "allow",
          "mkdir *": "allow",
          "cp *": "allow",
          "mv *": "allow",
          "echo *": "allow",
          "*": "ask"
        }
      }
    },
    "frontend(plan)": {
      "description": "Frontend planning agent - read-only mode for analyzing UI code and creating implementation plans",
      "mode": "subagent",
      "model": "opencode/mimo-v2.5-free",
      "prompt": "{file:.opencode/agents/frontend-plan.md}",
      "permission": {
        "edit": "deny",
        "bash": {
          "git *": "allow",
          "git status": "allow",
          "git log*": "allow",
          "git diff": "allow",
          "git diff*": "allow",
          "ls *": "allow",
          "cat *": "allow",
          "find *": "allow",
          "grep *": "allow",
          "pwd": "allow",
          "*": "deny"
        }
      }
    },
    "frontend(build)": {
      "description": "Frontend build agent - implements UI code from plans or prompts for Next.js + React + Tailwind",
      "mode": "primary",
      "model": "opencode/mimo-v2.5-free",
      "prompt": "{file:.opencode/agents/frontend-build.md}",
      "permission": {
        "edit": "allow",
        "bash": {
          "git *": "allow",
          "git status": "allow",
          "git log*": "allow",
          "git diff": "allow",
          "git diff*": "allow",
          "git add *": "allow",
          "git commit *": "allow",
          "git push*": "allow",
          "pnpm *": "allow",
          "npm *": "allow",
          "npx *": "allow",
          "node *": "allow",
          "ls *": "allow",
          "cat *": "allow",
          "find *": "allow",
          "grep *": "allow",
          "pwd": "allow",
          "mkdir *": "allow",
          "cp *": "allow",
          "mv *": "allow",
          "echo *": "allow",
          "*": "ask"
        }
      }
    }
  },

  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "pnpm *": "allow",
      "npm *": "allow",
      "git status": "allow",
      "git log*": "allow",
      "git diff": "allow",
      "git diff*": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "pwd": "allow",
      "echo *": "allow",
      "mkdir *": "allow",
      "cp *": "allow",
      "mv *": "allow"
    },
    "skill": {
      "*": "allow"
    }
  },

  "instructions": [
    "AGENTS.md",
    "docs/UNIVERSAL_SETUP.md",
    "docs/PROJECT_STATUS.md",
    "docs/backend/GUIDE.md",
    "docs/frontend/GUIDE.md"
  ],

  "share": "manual"
}
