{
  "name": "@sigizi/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "cross-env NODE_OPTIONS=--no-experimental-strip-types nest start --watch",
    "start": "node dist/src/main.js",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:generate": "pnpm exec dotenv -e ../../.env -- prisma generate",
    "prisma:migrate": "pnpm exec dotenv -e ../../.env -- prisma migrate dev",
    "prisma:studio": "pnpm exec dotenv -e ../../.env -- prisma studio",
    "prisma:seed": "pnpm exec dotenv -e ../../.env -- pnpm exec ts-node prisma/seed.ts",
    "prisma:reset": "pnpm exec dotenv -e ../../.env -- prisma migrate reset --force && pnpm prisma:generate",
    "prisma:fresh": "pnpm prisma:reset && pnpm prisma:seed",
    "prisma:reseed": "pnpm prisma:seed"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/swagger": "^7.3.0",
    "@nestjs/terminus": "^11.1.1",
    "@prisma/client": "^5.10.0",
    "@sigizi/shared": "workspace:*",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "pdfkit": "^0.17.2",
    "nestjs-pino": "^4.6.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@types/bcrypt": "^5.0.2",
    "@types/pdfkit": "^0.17.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/passport-jwt": "^4.0.1",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^7.4.0",
    "prisma": "^5.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
