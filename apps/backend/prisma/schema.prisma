generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum Role {
  SPPG_ADMIN
  SUPPLIER
}

enum BatchStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  FAILED
}

enum ComplaintStatus {
  PENDING
  REVIEWED
  RESOLVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DELIVERED
  COMPLETED
  CANCELLED
}

enum MouStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

enum StockSource {
  SYSTEM_ORDER
  MANUAL_ADJUSTMENT
  BATCH_RETURN
}

enum OperationalExpenseCategory {
  TRANSPORTATION
  FUEL
  VEHICLE_MAINTENANCE
  ADMINISTRATIVE
  UTILITIES
  OTHER
}

enum ReportType {
  DAILY
  WEEKLY
  MONTHLY
}

enum ReportSnapshotStatus {
  DRAFT
  FINAL
}

// ============================================================================
// MODELS
// ============================================================================

// ----------------------------------------------------------------------------
// 1. USER & ORGANIZATION
// ----------------------------------------------------------------------------

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  role      Role
  password  String?
  sppgId    String?
  sppg      Sppg?     @relation(fields: [sppgId], references: [id], onDelete: Restrict)
  supplierId String?
  supplier  Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Audit relationships
  createdOrders      Order[]              @relation("OrderCreatedBy")
  updatedOrders      Order[]              @relation("OrderUpdatedBy")
  paidOrders         Order[]              @relation("OrderPaidBy")
  cancelledOrders    Order[]              @relation("OrderCancelledBy")
  orderStatusChanges OrderStatusHistory[]
  createdBatches     Batch[]              @relation("BatchCreatedBy")
  updatedBatches     Batch[]              @relation("BatchUpdatedBy")
  createdBatchItems  BatchItem[]
  createdMous        Mou[]                @relation("MouCreatedBy")
  createdOperationalExpenses OperationalExpense[] @relation("OperationalExpenseCreatedBy")
  updatedOperationalExpenses OperationalExpense[] @relation("OperationalExpenseUpdatedBy")
  generatedReportSnapshots   ReportSnapshot[]     @relation("ReportSnapshotGeneratedBy")

  // Inventory audit relationships
  createdInventoryStocks InventoryStock[]
  adjustedStockLogs      InventoryAdjustmentLog[]

  @@index([sppgId])
  @@index([supplierId])
  @@index([role])
}

// ----------------------------------------------------------------------------
// 2. SPPG — Satuan Pelaksana Pemberian Makanan Gratis
// Alamat terstruktur + GPS untuk proximity-based supplier filtering
// ----------------------------------------------------------------------------

model Sppg {
  id          String   @id @default(cuid())
  name        String
  mitraId     String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // --- Alamat Terstruktur (wajib untuk filtering lokasi) ---
  address     String?  // Alamat bebas teks
  province    String   // Provinsi
  regency     String   // Kabupaten/Kota
  district    String   // Kecamatan
  village     String?  // Kelurahan/Desa
  postalCode  String?  // Kode Pos

  // --- Koordinat GPS (untuk perhitungan jarak) ---
  latitude    Float?   // -90 to 90
  longitude   Float?   // -180 to 180

  users           User[]
  beneficiaries   Beneficiary[]
  batches         Batch[]
  orders          Order[]
  mous            Mou[]
  inventoryStocks InventoryStock[]
  operationalExpenses OperationalExpense[]
  reportSnapshots     ReportSnapshot[]
}

// ----------------------------------------------------------------------------
// 3. SUPPLIER — Pemasok bahan baku
// NIB: Nomor Induk Berusaha (dokumen scan)
// Alamat terstruktur + GPS untuk proximity-based discovery oleh SPPG
// ----------------------------------------------------------------------------

model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  nib       String   @unique // File URL/path ke scan NIB
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- Alamat Terstruktur ---
  address     String?  // Alamat bebas teks
  province    String   // Provinsi
  regency     String   // Kabupaten/Kota
  district    String   // Kecamatan
  village     String?  // Kelurahan/Desa
  postalCode  String?  // Kode Pos

  // --- Koordinat GPS ---
  latitude    Float?   // -90 to 90
  longitude   Float?   // -180 to 180

  users     User[]
  items     SupplierItem[]
  orders    Order[]
  mous      Mou[]
}

// ----------------------------------------------------------------------------
// 4. SUPPLIER ITEM — Catalogue harga terkini (BISA BERUBAH)
// Harga di sini adalah "list price" / "catalogue price".
// Harga transaksi dibekukan di OrderItem.unitPrice / MouItem.agreedPrice.
// ----------------------------------------------------------------------------

model SupplierItem {
  id           String   @id @default(cuid())
  name         String
  unit         String
  basePrice    Float
  description  String?
  minOrderQty  Float?
  orderStep    Float?
  minThreshold Float?   // Batas ambang stok rendah per item (null = gunakan default sistem)
  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierId   String
  createdAt    DateTime @default(now())
  orderItems    OrderItem[]
  batchItems    BatchItem[]
  mouItems      MouItem[]
  inventoryStocks InventoryStock[]

  @@index([supplierId])
  @@index([name])
}

// ----------------------------------------------------------------------------
// 5. BENEFICIARY — Penerima manfaat (bukan hanya sekolah)
// ----------------------------------------------------------------------------

model Beneficiary {
  id                 String   @id @default(cuid())
  name               String
  institution        String
  institutionType    String?
  totalBeneficiary   Int
  address            String?
  contactPhone       String?
  contactEmail       String?
  sppg               Sppg     @relation(fields: [sppgId], references: [id], onDelete: Restrict)
  sppgId             String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([sppgId])
  @@index([institution])
}

// ----------------------------------------------------------------------------
// 6. MoU — Memorandum of Understanding / Kontrak Kerjasama
// Status flow: DRAFT → ACTIVE → EXPIRED / TERMINATED
// ----------------------------------------------------------------------------

model Mou {
  id             String    @id @default(cuid())
  mouNumber      String    @unique

  // --- Pihak-pihak ---
  sppg           Sppg      @relation(fields: [sppgId], references: [id], onDelete: Restrict)
  sppgId         String
  supplier       Supplier  @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierId     String

  // --- Masa Kontrak ---
  startDate      DateTime
  endDate        DateTime

  // --- Status ---
  status         MouStatus @default(DRAFT)

  // --- Dokumen & Ketentuan ---
  title          String
  nibSnapshot    String?   // NIB supplier saat kontrak dibuat (snapshot historis)
  terms          Json?     // { paymentTerms, deliverySchedule, penalties, dll }
  documentUrl    String?   // URL file MoU signed
  notes          String?

  // --- Audit ---
  createdBy      User      @relation("MouCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // --- Relationships ---
  items          MouItem[]
  orders         Order[]

  @@index([sppgId])
  @@index([supplierId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
}

// ----------------------------------------------------------------------------
// 7. MoU ITEM — Item dengan harga khusus dalam MoU
// Harga agreedPrice bisa beda dari SupplierItem.basePrice
// ----------------------------------------------------------------------------

model MouItem {
  id             String        @id @default(cuid())
  mou            Mou           @relation(fields: [mouId], references: [id], onDelete: Restrict)
  mouId          String
  item           SupplierItem  @relation(fields: [itemId], references: [id], onDelete: Restrict)
  itemId         String

  agreedPrice    Float
  minOrderQty    Float?
  maxOrderQty    Float?

  createdAt      DateTime      @default(now())

  @@unique([mouId, itemId])
}

// ----------------------------------------------------------------------------
// 8. ORDER — Pemesanan dari SPPG ke Supplier
// Status flow: PENDING → CONFIRMED → DELIVERED → COMPLETED
// opsional link ke MoU jika order berdasarkan kontrak
// ----------------------------------------------------------------------------

model Order {
  id         String      @id @default(cuid())
  status     OrderStatus @default(PENDING)
  total      Float
  notes      String?

  sppg       Sppg        @relation(fields: [sppgId], references: [id], onDelete: Restrict)
  sppgId     String
  supplier   Supplier    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierId String
  items      OrderItem[]

  // --- Link ke MoU (opsional) ---
  mou        Mou?        @relation(fields: [mouId], references: [id], onDelete: Restrict)
  mouId      String?

  // --- Delivery tracking ---
  expectedDeliveryDate DateTime?
  actualDeliveryDate   DateTime?
  deliveryEvidence     String?

  // --- Payment tracking ---
  paidAt               DateTime?
  paymentEvidenceUrl   String?
  paidById             String?
  paidBy               User?    @relation("OrderPaidBy", fields: [paidById], references: [id], onDelete: SetNull)

  // --- Cancellation tracking ---
  cancelledAt          DateTime?
  cancelledReason      String?
  cancelledById        String?
  cancelledBy          User?    @relation("OrderCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  // Audit trail
  createdBy            User     @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdById          String
  updatedBy            User?    @relation("OrderUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedById          String?

  // --- Status history ---
  statusHistory        OrderStatusHistory[]

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([sppgId])
  @@index([supplierId])
  @@index([status])
  @@index([createdById])
  @@index([mouId])
}

// ----------------------------------------------------------------------------
// 9. ORDER ITEM — Detail item dalam order
// Harga dibekukan saat order dibuat (snapshot dari SupplierItem.basePrice atau MouItem.agreedPrice)
// ----------------------------------------------------------------------------

model OrderItem {
  id       String @id @default(cuid())
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderId  String
  item     SupplierItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  itemId   String

  quantity    Float
  unitPrice   Float
  subtotal    Float

  // Price Validation Snapshot
  marketMedianAtPurchase Float?
  isWarningBypass        Boolean  @default(false)
  justificationNote      String?

  inventoryStocks InventoryStock[]

  @@index([orderId])
}

// ----------------------------------------------------------------------------
// 9A. INVENTORY STOCK — Lot-based stok bahan baku per SPPG
// Harga purchasePrice dikunci dari OrderItem.unitPrice saat order COMPLETED
// Mendukung FIFO (First-In, First-Out) untuk konsumsi stok
// ----------------------------------------------------------------------------

model InventoryStock {
  id            String       @id @default(cuid())

  sppg          Sppg         @relation(fields: [sppgId], references: [id], onDelete: Restrict)
  sppgId        String
  item          SupplierItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  itemId        String
  orderItem     OrderItem?   @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  orderItemId   String?

  source        StockSource  @default(SYSTEM_ORDER)
  purchasePrice Float        // Harga lock saat dibeli dari supplier
  initialQty    Float        // Jumlah total yang dibeli di awal
  remainingQty  Float        // Sisa stok aktif yang bisa dipakai untuk Batch

  // Pelacakan masa berlaku untuk perishable goods (Mendukung FEFO di masa depan)
  expiredAt     DateTime?

  // Audit Fields
  createdById   String
  createdBy     User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  notes         String?

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  batchItems    BatchItem[]
  adjustments   InventoryAdjustmentLog[]

  @@index([sppgId, itemId])
  @@index([remainingQty])
  @@index([expiredAt])
}

// ----------------------------------------------------------------------------
// 9B. INVENTORY ADJUSTMENT LOG — Audit trail penyesuaian stok
// Catatan setiap perubahan manual pada InventoryStock
// ----------------------------------------------------------------------------

model InventoryAdjustmentLog {
  id               String         @id @default(cuid())
  inventoryStock   InventoryStock @relation(fields: [inventoryStockId], references: [id], onDelete: Restrict)
  inventoryStockId String

  adjustmentQty    Float          // Negatif untuk pengurangan, positif untuk penambahan
  reason           String         // SPOILAGE, THEFT, DISCREPANCY, dll
  description      String?

  changedById      String
  changedBy        User           @relation(fields: [changedById], references: [id], onDelete: Restrict)
  createdAt        DateTime       @default(now())

  @@index([inventoryStockId])
  @@index([createdAt])
}

// ----------------------------------------------------------------------------
// 9C. ORDER STATUS HISTORY — Audit trail perubahan status order
// Append-only: tidak bisa dihapus atau diubah
// ----------------------------------------------------------------------------

model OrderStatusHistory {
  id           String      @id @default(cuid())
  orderId      String
  order        Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  fromStatus   OrderStatus?
  toStatus     OrderStatus
  changedById  String
  changedBy    User        @relation(fields: [changedById], references: [id], onDelete: Restrict)
  notes        String?
  evidenceUrl  String?
  createdAt    DateTime    @default(now())

  @@index([orderId])
  @@index([toStatus])
  @@index([createdAt])
}

// ----------------------------------------------------------------------------
// 10. BATCH — Satu kali produksi makanan
// costPerPortion dan totalCost dihitung otomatis dari BatchItems
// ----------------------------------------------------------------------------

model Batch {
  id               String      @id @default(cuid())
  batchNumber      String      @unique
  reportKey        String      @unique
  date             DateTime    @default(now())
  menu             String
  nutrition        Json?
  allergens        String[]
  beneficiaryCount Int?
  beneficiaryNames String[]    // Nama-nama penerima manfaat

  costPerPortion   Float
  totalCost        Float

  // --- Regulasi MBG (Rp 10.000/porsi) ---
  costPerPortionStandard Int      @default(10000)
  totalBudget            Float    @default(0)
  budgetVariance         Float?   // actual - budget (negatif = under budget)

  // --- Failure tracking ---
  failedReason   String?
  failedEvidence String?   // URL foto bukti
  failedAt       DateTime?

  sppg             Sppg        @relation(fields: [sppgId], references: [id], onDelete: Restrict)
  sppgId           String
  status           BatchStatus @default(ACTIVE)

  batchItems       BatchItem[]
  complaints       Complaint[]

  // Audit trail
  createdBy        User     @relation("BatchCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdById      String
  updatedBy        User?    @relation("BatchUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedById      String?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([sppgId])
  @@index([batchNumber])
  @@index([date])
  @@index([status])
  @@index([createdById])
}

// ----------------------------------------------------------------------------
// 11. BATCH ITEM — Bahan baku yang digunakan dalam batch
// Harga diambil dari SupplierItem.basePrice saat batch dibuat
// ----------------------------------------------------------------------------

model BatchItem {
  id          String    @id @default(cuid())
  batch       Batch     @relation(fields: [batchId], references: [id], onDelete: Restrict)
  batchId     String
  item        SupplierItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  itemId      String

  inventoryStock   InventoryStock? @relation(fields: [inventoryStockId], references: [id], onDelete: Restrict)
  inventoryStockId String?

  name        String?   // Nama item (e.g., "Nasi 100g", "Ayam Paha 100g")
  unit        String?   // Satuan (e.g., "kg", "pcs", "liter")
  quantity    Float
  unitPrice   Float
  subtotal    Float

  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdById String
  createdAt   DateTime @default(now())

  @@index([batchId])
  @@index([itemId])
  @@index([inventoryStockId])
}

// ----------------------------------------------------------------------------
// 12. COMPLAINT — Keluhan masyarakat
// ----------------------------------------------------------------------------

model Complaint {
  id          String          @id @default(cuid())
  reportKey   String
  description String
  evidence    String?
  status      ComplaintStatus @default(PENDING)
  notes       String?
  batch       Batch           @relation(fields: [batchId], references: [id], onDelete: Restrict)
  batchId     String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([batchId])
  @@index([status])
  @@index([reportKey])
}

// ----------------------------------------------------------------------------
// 13. OPERATIONAL EXPENSE — Pengeluaran operasional non-batch/non-order
// ----------------------------------------------------------------------------

model OperationalExpense {
  id          String                     @id @default(cuid())
  sppg        Sppg                       @relation(fields: [sppgId], references: [id], onDelete: Restrict)
  sppgId      String

  category    OperationalExpenseCategory
  amount      Float
  expenseDate DateTime
  description String
  evidenceUrl String?
  notes       String?

  createdBy   User   @relation("OperationalExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdById String
  updatedBy   User?  @relation("OperationalExpenseUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedById String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sppgId, expenseDate])
  @@index([category])
  @@index([createdById])
}

// ----------------------------------------------------------------------------
// 14. REPORT SNAPSHOT — Immutable report result + PDF pointer
// ----------------------------------------------------------------------------

model ReportSnapshot {
  id           String               @id @default(cuid())
  sppg         Sppg                 @relation(fields: [sppgId], references: [id], onDelete: Restrict)
  sppgId       String

  type         ReportType
  periodKey    String
  startDate    DateTime
  endDate      DateTime
  status       ReportSnapshotStatus @default(FINAL)

  totalPortions Int    @default(0)
  totalCogs     Float  @default(0)
  totalProcured Float  @default(0)
  totalOpex     Float  @default(0)
  budgetVariance Float @default(0)
  warningBypassCount Int @default(0)

  payload      Json?
  pdfPath      String?
  pdfHash      String?

  generatedBy   User   @relation("ReportSnapshotGeneratedBy", fields: [generatedById], references: [id], onDelete: Restrict)
  generatedById String

  generatedAt  DateTime @default(now())
  finalizedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([sppgId, type, periodKey])
  @@index([sppgId, type, status])
  @@index([startDate])
  @@index([endDate])
}
